{
  "name": "vigilis-frontend",
  "version": "1.0.0",
  "description": "Vigilis Desktop Frontend",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "cd renderer && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "cd renderer && npm run build && electron-builder"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "wait-on": "^7.0.1"
  }
}
